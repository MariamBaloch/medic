# Copy to .env and fill in the secrets.
# Generate a secret with: openssl rand -base64 32

# Secrets. Compose refuses to start if any of these is empty.
POSTGRES_PASSWORD=
MEDIC_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
BOOKING_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
AUDIT_DB_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=

# Mailpit does not need credentials. Fill these only for a real SMTP server.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Application. APP_TIME_ZONE is Asia/Bahrain (UTC+3).
# GATEWAY_READ_TIMEOUT=1h
APP_BASE_URL=http://localhost:8080
APP_TIME_ZONE=Asia/Bahrain
JWT_EXPIRATION=3600000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174
GATEWAY_READ_TIMEOUT=1h
IMAGE_TAG=local

# Host ports
GATEWAY_PORT=8080
BOOKING_PORT=8081
IDENTITY_PORT=8082
NOTIFICATION_PORT=8084
AUDIT_PORT=8085
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_UI_PORT=8088
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
